SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/streamcut
SPRING_DATASOURCE_USERNAME=streamcut
SPRING_DATASOURCE_PASSWORD=change-me

APP_STORAGE_LOCAL_ROOT=/var/lib/streamcut/storage

APP_OPERATOR_USERNAME=operator
APP_OPERATOR_PASSWORD=change-me

APP_ARTIFACT_STORAGE_MODE=S3
APP_ARTIFACT_STORAGE_ENDPOINT=http://s3-internal:9000
APP_ARTIFACT_STORAGE_PUBLIC_ENDPOINT=https://artifacts.example.com
APP_ARTIFACT_STORAGE_REGION=us-east-1
APP_ARTIFACT_STORAGE_ACCESS_KEY=change-me
APP_ARTIFACT_STORAGE_SECRET_KEY=change-me
APP_ARTIFACT_STORAGE_BUCKET=streamcut-artifacts-prod
APP_ARTIFACT_STORAGE_PRESIGN_TTL=15m

SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=512MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=520MB
